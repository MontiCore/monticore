From 493a94eb1630857862cf509f9816dba88c154375 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alex=20L=C3=BCpges?= <luepges@se-rwth.de>
Date: Mon, 3 Nov 2025 13:44:32 +0100
Subject: [PATCH] restrict logback version of the generator


diff --git a/monticore-generator/build.gradle b/monticore-generator/build.gradle
index 681118f6d..8a03e9050 100644
--- a/monticore-generator/build.gradle
+++ b/monticore-generator/build.gradle
@@ -47,8 +47,8 @@ dependencies {
     implementation group: 'org.apache.commons', name: 'commons-text', version: '1.10.0'
 
 //  implementation 'org.slf4j:slf4j-api:1.7.10'
-    implementation 'ch.qos.logback:logback-classic:1.2.0'
-    implementation 'ch.qos.logback:logback-core:1.2.0'
+    implementation 'ch.qos.logback:logback-classic:[1.2.9,1.3.0)' // we appear to be incompatible with logback >= 1.3.0
+    implementation 'ch.qos.logback:logback-core:[1.2.9,1.3.0)'
 
     implementation "de.monticore.lang:cd4analysis:$cd4a_version"
     implementation "org.antlr:antlr4:$antlr_version"
-- 
2.42.0.windows.2

