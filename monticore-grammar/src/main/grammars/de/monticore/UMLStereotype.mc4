/* (c) https://github.com/MontiCore/monticore */
package de.monticore;

/* This is a MontiCore stable grammar.
 * Adaptations -- if any -- are conservative. */

import de.monticore.literals.*;
import de.monticore.expressions.ExpressionsBasis;

/**
 * Grammar for common elements of the UML/P-Language-Family
 * 
 * This grammars defines Stereotypes like 
 *   <<val1,val2="text",...>>
 * 
 * Methods contains(name), getValue(name) assist String Stereotype retrieval.
 *
 */
component grammar UMLStereotype extends ExpressionsBasis, MCCommonLiterals {

    /*========================================================================*/
    /*============================== GRAMMAR =================================*/
    /*========================================================================*/

    /** ASTStereotype represents Stereotypes in the UML/P
        @attribute values List of Values of this Stereotype
    */
    Stereotype =
         "<<"  values:(StereoValue || ",")+ ">>" ;

    // Due to possible scanner clashes with "List<List<String>>"
    // we split the token:
    splittoken ">>";
    
    /** ASTStereoValue represents a Value of a Stereotype in the UML/P
        @attribute name       Name of the Stereotype-Value
        @attribute expression Content of the Stereotype
    */
    StereoValue =
        Name& ("=" Expression)?;

    /*========================================================================*/
    /*======================== AST extension =================================*/
    /*========================================================================*/

    astrule Stereotype =
        method public boolean contains(String name) {
          for (ASTStereoValue sv : values) {
            if (sv.getName().equals(name)) {
              return true;
            }
          }
          return false;
        }
        method public boolean contains(String name, String value) {
          for (ASTStereoValue sv : values) {
            if (sv.getName().equals(name)) {
              return sv.getValue().equals(value);
            }
          }
          return false;
        }
        method public String getValue(String name) {
          for (ASTStereoValue sv : values) {
            if (sv.getName().equals(name)) {
              return sv.getValue();
            }
          }
          throw new java.util.NoSuchElementException();
        };

    astrule StereoValue =
        // Caution: decoded value is in cache: so change of value leads
        // to outdated result in getValue()
        content:String
        text:StringLiteral?
        method public String getValue() {
          if (content == null) {
            if (isPresentExpression()
              && de.monticore.expressions.expressionsbasis.ExpressionsBasisMill
              .typeDispatcher()
              .isExpressionsBasisASTLiteralExpression(expression.get())
              && de.monticore.literals.mccommonliterals.MCCommonLiteralsMill
              .typeDispatcher().isMCCommonLiteralsASTStringLiteral(de.monticore
              .expressions.expressionsbasis.ExpressionsBasisMill.typeDispatcher()
                .asExpressionsBasisASTLiteralExpression(expression.get())
                .getLiteral())) {
              content = de.monticore.literals.MCLiteralsDecoder
              .decodeString(de.monticore.literals.mccommonliterals
              .MCCommonLiteralsMill.typeDispatcher()
                .asMCCommonLiteralsASTStringLiteral(de.monticore.expressions
                .expressionsbasis.ExpressionsBasisMill.typeDispatcher()
                  .asExpressionsBasisASTLiteralExpression(expression.get())
                  .getLiteral())
                .getValue());
            } else {
              content = "";   // absent value
            }
          }
          return content;
        }
        method public boolean isPresentText() {
          if ((text == null || text.isEmpty()) && isPresentExpression() &&
            de.monticore.expressions.expressionsbasis.ExpressionsBasisMill
              .typeDispatcher()
              .isExpressionsBasisASTLiteralExpression(expression.get())
                && de.monticore.literals.mccommonliterals.MCCommonLiteralsMill
                .typeDispatcher().isMCCommonLiteralsASTStringLiteral(de.monticore
                .expressions.expressionsbasis.ExpressionsBasisMill
                .typeDispatcher().asExpressionsBasisASTLiteralExpression(expression.get())
                  .getLiteral())) {
            text = java.util.Optional.of(de.monticore.literals
              .mccommonliterals.MCCommonLiteralsMill.typeDispatcher()
                .asMCCommonLiteralsASTStringLiteral(de.monticore.expressions
                  .expressionsbasis.ExpressionsBasisMill.typeDispatcher()
                  .asExpressionsBasisASTLiteralExpression(expression.get())
                    .getLiteral()));
          }
          return text.isPresent();
        };
}
