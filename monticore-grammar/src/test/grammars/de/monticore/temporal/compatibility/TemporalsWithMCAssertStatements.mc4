package de.monticore.temporal.compatibility;

/* Combines the temporal grammars with MCAssertStatements (and CommonExpressions for the expression templates)
 * to test their compatibility, see AbstractTemporalCompatibilityTest. */
grammar TemporalsWithMCAssertStatements extends de.monticore.temporal.ISOTemporals,
    de.monticore.temporal.DETemporals,
    de.monticore.temporal.EscapedTemporalLiterals,
    de.monticore.expressions.CommonExpressions,
    de.monticore.statements.MCAssertStatements {
  Temporal = Instant | Period;
  EscapedTemporals = EscapedTemporalLiteral+;
  TemporalExpression = Expression;
}
