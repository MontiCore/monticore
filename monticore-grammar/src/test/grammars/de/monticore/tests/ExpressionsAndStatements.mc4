package de.monticore.tests;

import de.monticore.expressions.*;
import de.monticore.literals.*;
import de.monticore.ocl.*;
import de.monticore.regex.*;
import de.monticore.siunit.*;
import de.monticore.statements.*;
import de.monticore.symbols.*;
import de.monticore.types.*;

/* Test Grammar: This is not intended to become a MontiCore stable grammar. */

grammar ExpressionsAndStatements
    extends
            // Literals
            MCCommonLiterals,
            SIUnitLiterals,
            // Expressions
            AssignmentExpressions,
            BitExpressions,
            LambdaExpressions,
            OCLExpressions,
            OptionalOperators,
            SetExpressions,
            TupleExpressions,
            UglyExpressions,
            // Types
            MCArrayTypes,
            MCBasicTypes,
            MCFunctionTypes,
            MCSimpleGenericTypes,
            MCStructuralTypes,
            RegExType,
            SIUnitTypes4Computing,
            SIUnitTypes4Math,
            // Statements
            MCArrayStatements,
            MCAssertStatements,
            MCCommonStatements,
            MCExceptionStatements,
            MCLowLevelStatements,
            MCReturnStatements,
            MCSynchronizedStatements,
            MCVarDeclarationStatements,
            // Symbols
            OOSymbols {

  BehaviorInput =
    MCImportStatement*
    MCBlockStatement*
    Expression?
  ;

  // Unused
  NonModifier implements MCModifier = "_does_not_occur#$@";

}
