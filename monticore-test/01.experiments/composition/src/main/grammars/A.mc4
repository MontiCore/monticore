grammar A {
  N = "n";

  // Test, that classes (from the classpath) are useable in the astextends part
  MyProd implements MyInterfaceASTExtends astextends composition.MyClass   ;
  interface MyInterfaceASTExtends astextends composition.MyInterface; // any class not specified by a grammar
}
