/* (c) https://github.com/MontiCore/monticore */
/*
 * This Grammar demonstrates the use of the interpreter.
 * We use nested variable declarations and function declarations to prove the new interpreter works.
 * If you want to use it as well make sure your scopes are shadowing so you can actually resolve the correct names.
 * To store a variable, the production rule needs to implement the Variable interface from de.monticore.symbols.BasicSymbol sand
 * To store a function it needs to implement the Function interface from de.monticore.symbols.BasicSymbols.
 *
 */
grammar SimpleEquations extends Numerals, de.monticore.symbols.BasicSymbols {

  symbol scope (shadowing) SimpleEquationCompilationUnit = Name "{" ProgramBlock "}";
  scope (shadowing) ProgramBlock = (Expression ";" )*  ;

  interface Expression;

  FunctionCall implements Expression = Name "(" ArgList ")";
  ArgList = (args:Expression ("," args:Expression)*)?;

  symbol scope (shadowing) FunctionDefinition implements Function, Expression = returnType:Name "func" name:Name FormalParameters "{" ProgramBlock "}";
  FormalParameters = "(" FormalParameterListing? ")";
  FormalParameterListing = (VariableAsParameter | ",")+;
  VariableAsParameter implements Variable = type:Name Name;

  PlusEquation implements Expression = left:Expression "+" right:Expression;
  MinusEquation implements Expression = left:Expression "-" right:Expression;
  MultiplyEquation implements Expression = left:Expression "*" right:Expression;
  DivideEquation implements Expression = left:Expression "/" right:Expression;
  GreaterThanExpression implements Expression = left:Expression ">" right:Expression;
  LessThanExpression implements Expression = left:Expression "<" right:Expression;

  symbol VariableDefinition implements Variable, Expression = type:Name Name "=" value:Expression;
  VariableUsage implements Expression = Name "=" value:Expression;
  PrintStatement implements Expression = "print" "(" Expression ")";
  IfStatement implements Expression = "if" "(" condition:Expression ")" "{" thenBlock:ProgramBlock "}" ("else" "{" elseBlock:ProgramBlock "}")?;
  ReturnStatement implements Expression = "return" Expression;

  NameExpression implements Expression = Name;
  NumberExpression implements Expression = Number;
}