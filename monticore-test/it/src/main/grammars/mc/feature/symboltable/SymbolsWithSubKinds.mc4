package mc.feature.symboltable;


grammar SymbolsWithSubKinds {

  interface Vehicle;
  scope symbol Car implements Vehicle = "car" Name;
  interface Leg;
  scope symbol Animal implements Leg = "animal" Name;
  interface Tire;
  scope symbol Cabriolet extends Car implements Tire = "cabriolet" Name;
  Beatle extends Cabriolet = "beatle" Name;
  Mazda extends Cabriolet = "mazda" Name;
  scope symbol Truck extends Car implements Tire = "truck" Name;
  Ford extends Truck = "ford" Name;
  Volvo extends Truck = "volvo" Name;
  Dog extends Animal = "dog" Name;
  Cat extends Animal = "cat" Name;
  Fish extends Animal = "fish" Name;
  token Name =
          ( 'a'..'z' | 'A'..'Z' | '_' | '$' )( 'a'..'z' | 'A'..'Z' | '_' | '0'..'9' | '$' )*;
}
