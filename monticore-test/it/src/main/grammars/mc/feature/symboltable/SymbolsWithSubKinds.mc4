package mc.feature.symboltable;


grammar SymbolsWithSubKinds {

  symbol scope Zoo =
    "zoo" Name "{" (Vehicle | Animal)* "}" ;

  interface Vehicle;

  symbol scope Car implements Vehicle =
    "car" Name;

  interface Leg;

  symbol scope Animal implements Leg =
    "animal" Name;

  interface Tire;

  symbol scope Cabriolet extends Car implements Tire =
    "cabriolet" Name;

  symbol scope Beatle extends Cabriolet =
    "beatle" Name;

  symbol scope Mazda extends Cabriolet = "mazda" Name;

  symbol scope Truck extends Car implements Tire =
    "truck" Name;

  symbol scope Ford extends Truck =
    "ford" Name;

  symbol scope Volvo extends Truck =
    "volvo" Name;

  symbol scope Dog extends Animal =
    "dog" Name;

  symbol scope Cat extends Animal =
    "cat" Name;

  symbol scope Fish extends Animal =
    "fish" Name;

  token Name =
    ( 'a'..'z' | 'A'..'Z' | '_' | '$' )( 'a'..'z' | 'A'..'Z' | '_' | '0'..'9' | '$' )*;

}
