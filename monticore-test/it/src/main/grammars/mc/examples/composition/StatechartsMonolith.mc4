package mc.examples.composition;

grammar StatechartsMonolith extends de.monticore.MCBasics {
 Statechart = "statechart" Name
  "{" (S|T)* "}";
 S = "state" Name ";";
 T = from:Name "->" to:Name
  ("[" precondition:Expr "]") ";";
 Expr = Name | "(" Expr ")" | "!" Expr
  | left:Expr "&&" right:Expr |
  | left:Expr "||" right:Expr | ;
}
